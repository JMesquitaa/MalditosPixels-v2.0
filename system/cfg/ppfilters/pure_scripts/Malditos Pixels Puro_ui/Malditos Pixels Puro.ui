PURE_PP_UI_drawText("Sobre", "MALDITOS RACHADORES",
    {
        rgbm = rgbm(0.9, 0.1, 0.1, 1),
        x = 0, y = 8,
        width = -1,
        font = ui.Font.Title,
        horizontal_alignment = ui.Alignment.Center,
        vertical_alignment = ui.Alignment.Start,
    })

PURE_PP_UI_drawText("Sobre", "MALDITOS PIXELS",
    {
        rgbm = rgbm(1, 1, 1, 1),
        x = 0, y = 36,
        width = -1,
        font = ui.Font.Main,
        horizontal_alignment = ui.Alignment.Center,
        vertical_alignment = ui.Alignment.Start,
    })

PURE_PP_UI_drawText("Sobre", "The cinematic side of illegal street racing.\nO lado cinematografico das corridas ilegais de rua.",
    {
        rgbm = rgbm(0.75, 0.75, 0.75, 0.95),
        x = 0, y = 60,
        width = -1,
        font = ui.Font.Italic,
        horizontal_alignment = ui.Alignment.Center,
        vertical_alignment = ui.Alignment.Start,
    })

PURE_PP_UI_drawText("Sobre", "Comecou como meme.\nUm Discord na zueira.\nVirou encontro de racha.\nUma equipe. Uma obsessao.\n\nNossos carros. Nossos mods. Nosso filtro.\nSimulacao maxima na pista.\nRealismo maximo na tela.\n\nMalditos Pixels nao e um filtro comum.\nE um filtro construido por rachadores.\nCenas que refletem o real.\nA madrugada do jeito que ela e.\n\nSe voce esta aqui, ja e um de nos.\nSeja bem-vindo a equipe.",
    {
        rgbm = rgbm(0.65, 0.65, 0.65, 0.9),
        x = 0, y = 95,
        width = -1,
        font = ui.Font.Main,
        horizontal_alignment = ui.Alignment.Center,
        vertical_alignment = ui.Alignment.Start,
    })

PURE_PP_UI_drawText("Sobre", "JMesquitaa | 60.000 Miles | Paulinho | Sauce | PhB | Malditos Rachadores",
    {
        rgbm = rgbm(0.55, 0.55, 0.55, 0.75),
        x = 0, y = 320,
        width = -1,
        font = ui.Font.Small,
        horizontal_alignment = ui.Alignment.Center,
        vertical_alignment = ui.Alignment.Start,
    })

PURE_PP_UI_drawText("Sobre", "(c) 2026 Malditos Rachadores - Todos os direitos reservados.",
    {
        rgbm = rgbm(0.35, 0.35, 0.35, 0.5),
        x = 0, y = 338,
        width = -1,
        font = ui.Font.Tiny,
        horizontal_alignment = ui.Alignment.Center,
        vertical_alignment = ui.Alignment.Start,
    })
